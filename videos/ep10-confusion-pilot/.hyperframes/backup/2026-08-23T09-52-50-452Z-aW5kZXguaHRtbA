    .rv-label-top{top:560px;font:900 54px/1 CapcutKR,sans-serif;color:var(--sub)}
    .rv-hero-wrap{top:680px;height:460px}
    .rv-hero{position:relative;z-index:2;font-family:CapcutKR,sans-serif;font-size:400px;line-height:1;color:var(--mint)}
    .rv-sub-wrap{top:1240px;display:flex;flex-direction:column;align-items:center;gap:14px}
    .rv-sub-main{font:900 64px/1 CapcutKR,sans-serif;color:var(--ink)}
    .rv-sub-en{font:700 32px/1 BarlowC,sans-serif;letter-spacing:.08em;color:var(--sub)}

    .ru-track{top:820px;height:220px}
    .ru-block{position:relative;width:280px;display:flex;flex-direction:column;align-items:center;gap:10px;will-change:transform}
    .ru-chip{padding:26px 40px;border-radius:16px;background:var(--pill);border:2px solid var(--pill-line);font:800 92px/1 Bebas,sans-serif;letter-spacing:.02em;color:var(--ink)}
    .ru-cap{font:700 28px/1 BarlowC,sans-serif;letter-spacing:.1em;color:var(--sub);text-transform:uppercase}
    .ru-gap{width:120px}
    .ru-fused-wrap{top:850px;height:220px}
    .ru-fused{position:relative;z-index:2;font-family:CapcutKR,sans-serif;font-size:200px;line-height:1;color:var(--mint)}
    .ru-strip-wrap{top:1230px;flex-direction:column;align-items:center;gap:18px}
