    .footer-note{top:1420px;font:700 30px/1 BarlowC,sans-serif;letter-spacing:.12em;color:var(--sub);text-transform:uppercase}

    .hero-static{position:relative;z-index:2;font-family:Bebas,sans-serif;font-size:148px;line-height:1;letter-spacing:.005em;color:var(--ink);white-space:nowrap}

