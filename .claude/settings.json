{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-briefing-hook.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-banned-terms.mjs\" --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/sync-render-to-package.mjs\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "abracadabrax-youtube-thumbnail-maker@anthropic-plugin-directory": false,
    "cowork-plugin-management@knowledge-work-plugins": false
  }
}
