    .chip-brand{padding:24px 40px;border-radius:16px;background:var(--pill);border:2px solid var(--pill-line);font:400 40px/1 CapcutKR,sans-serif;color:var(--ink)}
    .chip-ep{padding:24px 36px;border-radius:16px;background:var(--mint);font:800 36px/1 BarlowC,sans-serif;letter-spacing:.04em;color:#052018}
  </style>
</head>
