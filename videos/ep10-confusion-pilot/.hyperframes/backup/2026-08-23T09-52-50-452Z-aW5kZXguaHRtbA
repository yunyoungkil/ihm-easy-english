    .ho-sweep{position:absolute;top:0;bottom:0;width:180px;background:linear-gradient(105deg,transparent 0%,rgba(255,255,255,.55) 50%,transparent 100%);opacity:0}
    .ho-strip{top:1080px;font:900 54px/1.2 CapcutKR,sans-serif;color:var(--sub);text-align:center;max-width:920px}
    .ho-strip b{color:var(--mint)}
