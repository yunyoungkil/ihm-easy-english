  <script>
    window.__timelines = window.__timelines || {};

    const hash = (n) => {
      const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
      return x - Math.floor(x);
    };

    function makeParticleBurst(fieldId, opts) {
      const field = document.getElementById(fieldId);
      const { count, palette, radial, cone, speedMin, speedMax, g, sizeMin, sizeMax } = opts;
      const parts = [];
      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.style.position = 'absolute';
        el.style.left = '0';
        el.style.top = '0';
        el.style.borderRadius = '50%';
        el.style.opacity = '0';
        el.style.willChange = 'transform, opacity';
        const size = sizeMin + hash(i * 3 + 1) * (sizeMax - sizeMin);
        el.style.width = size + 'px';
        el.style.height = size + 'px';
        el.style.background = palette[i % palette.length];
        field.appendChild(el);
        let angle;
        if (radial) {
          angle = hash(i * 5 + 2) * Math.PI * 2;
        } else {
          angle = -Math.PI / 2 + (hash(i * 5 + 2) * 2 - 1) * cone;
        }
        const speed = speedMin + hash(i * 7 + 3) * (speedMax - speedMin);
        parts.push({ el, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, spin: (hash(i * 11 + 4) * 2 - 1) * 90 });
      }
      return { parts, g };
    }

    function driveBurst(tl, burst, burstAt, flightDur, fadeFrac) {
      const drive = { T: 0 };
      tl.fromTo(drive, { T: 0 }, {
        T: 1,
        duration: flightDur,
        ease: 'none',
        onUpdate: () => {
          const t = drive.T * flightDur;
          const fade = Math.min(1, (1 - drive.T) / fadeFrac);
          burst.parts.forEach((p) => {
            const x = p.vx * t;
            const y = p.vy * t + 0.5 * burst.g * t * t;
            p.el.style.transform = `translate(${x}px, ${y}px) rotate(${p.spin * t}deg)`;
            p.el.style.opacity = String(drive.T === 0 ? 0 : fade);
          });
        },
      }, burstAt);
    }

    const tl = gsap.timeline({ paused: true });

    // ===================== SECTION 1 — HOOK (0 – 3.2) =====================
    gsap.set('#hk-badge', { opacity: 0 });
    tl.to('#hk-badge', { opacity: 1, duration: 0.3, ease: 'power2.out' }, 0.05);

    // hero word entrance — fast scale-in settle (power4.out front, no overshoot)
    gsap.set('#hk-hero', { scale: 2.05, opacity: 0 });
    gsap.set('#hk-glow', { scale: 0.85, opacity: 0 });
    tl.to('#hk-hero', { scale: 1, opacity: 1, duration: 0.42, ease: 'power4.out' }, 0.05);
    tl.to('#hk-glow', { scale: 1, opacity: 0.28, duration: 0.42, ease: 'power2.out' }, 0.05);

    // glitch emphasis bursts on CONFUSION (RGB split) — thematically "confused" word
    (function () {
      const copies = gsap.utils.toArray('#hk-hero .glitch-copy');
      const bursts = [0.62, 0.98];
      bursts.forEach((start) => {
        const amp = { a: 0 };
        tl.set(amp, { a: 1 }, start);
        tl.set(copies, { opacity: 0.75 }, start);
        tl.to(amp, {
          a: 0,
          duration: 0.16,
          ease: 'power3.in',
          onUpdate: () => {
            const step = Math.floor(tl.time() / 0.05);
            copies.forEach((el, layer) => {
              const jx = (hash(step * 13 + layer * 7) * 2 - 1) * 10 * amp.a;
              const jy = (hash(step * 29 + layer * 11) * 2 - 1) * 3.5 * amp.a;
              gsap.set(el, { x: jx, y: jy });
            });
          },
        }, start);
        tl.set(copies, { x: 0, y: 0, opacity: 0 }, start + 0.16);
      });
    })();

    tl.fromTo('#hk-question', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' }, 1.30);
    tl.fromTo('#hk-pill-wrong', { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.42, ease: 'power3.out' }, 1.55);
    tl.fromTo('#hk-pill-right', { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.42, ease: 'power3.out' }, 1.63);
    tl.fromTo('#hk-footer', { opacity: 0 }, { opacity: 1, duration: 0.3, ease: 'power2.out' }, 1.9);

    // ===================== SECTION 2 — SPOTLIGHT (3.2 – 4.7) =====================
    tl.to('#sp-pill-right', {
      scale: 1.08, backgroundColor: '#0C2620', borderColor: '#00E5A0',
      duration: 0.3, ease: 'power2.out',
    }, 3.25);
    tl.to('#sp-pill-wrong', { opacity: 0.4, duration: 0.3, ease: 'power2.out' }, 3.25);
    tl.to('#sp-glow', { opacity: 0.22, duration: 0.5, ease: 'power2.out' }, 3.25);

    // ===================== SECTION 3 — REVEAL (4.7 – 5.9) =====================
    tl.fromTo('#flash', { opacity: 0 }, { opacity: 0.92, duration: 0.05, ease: 'none' }, 4.70);
    tl.to('#flash', { opacity: 0, duration: 0.18, ease: 'power1.in' }, 4.75);

    gsap.set('#rv-hero', { scale: 0, opacity: 0 });
    gsap.set('#rv-glow', { scale: 0.85, opacity: 0 });
    gsap.set('#rv-label', { opacity: 0, y: 16 });
    gsap.set('#rv-sub-main', { opacity: 0, y: 16 });
    gsap.set('#rv-sub-en', { opacity: 0 });

    tl.to('#rv-hero', { scale: 1, opacity: 1, duration: 0.5, ease: 'expo.out' }, 4.75);
    tl.to('#rv-glow', { scale: 1, opacity: 0.32, duration: 0.5, ease: 'power2.out' }, 4.75);
    tl.to('#rv-label', { opacity: 1, y: 0, duration: 0.32, ease: 'power3.out' }, 4.95);
    tl.to('#rv-sub-main', { opacity: 1, y: 0, duration: 0.32, ease: 'power3.out' }, 5.25);
    tl.to('#rv-sub-en', { opacity: 1, duration: 0.32, ease: 'power2.out' }, 5.35);

    const rvBurst = makeParticleBurst('rv-particles', {
      count: 16, palette: ['#00E5A0', '#00B586', '#FFFFFF'], radial: true,
      speedMin: 260, speedMax: 520, g: 60, sizeMin: 5, sizeMax: 10,
    });
    driveBurst(tl, rvBurst, 5.25, 0.65, 0.3);

    // ===================== SECTION 4 — RULE (5.9 – 7.9, local 0-2.0) =====================
    gsap.set('#ru-block-u', { x: -560, opacity: 0 });
    gsap.set('#ru-block-si', { x: 560, opacity: 0 });
    gsap.set('#ru-fused', { scale: 0, opacity: 0 });
    gsap.set('#ru-glow', { scale: 0.85, opacity: 0 });
    gsap.set('#ru-strip', { opacity: 0, y: 16 });
    gsap.set('#ru-bar', { scaleX: 0 });

    (function () {
      const driver = { p: 0 };
      const START = 5.98, DUR = 0.42;
      tl.to(driver, {
        p: 1, duration: DUR, ease: 'power2.out',
        onUpdate: () => {
          const p = driver.p;
          const ux = -560 * (1 - p);
          const sx = 560 * (1 - p);
          document.getElementById('ru-block-u').style.transform = `translate(${ux}px,0)`;
          document.getElementById('ru-block-u').style.opacity = String(Math.min(1, p * 4));
          document.getElementById('ru-block-si').style.transform = `translate(${sx}px,0)`;
          document.getElementById('ru-block-si').style.opacity = String(Math.min(1, p * 4));
        },
      }, START);
    })();

    const COLLIDE_AT = 5.98 + 0.42; // 6.40
    // tiny deterministic impact shake
    [0, 1 / 20, 2 / 20].forEach((dt, i) => {
      const offs = [[5, -3], [-4, 2], [0, 0]];
      tl.set('#ru-shake-wrap', { x: offs[i][0], y: offs[i][1] }, COLLIDE_AT + dt);
    });
    tl.fromTo('#flash2', { opacity: 0 }, { opacity: 0.85, duration: 0.04, ease: 'none' }, COLLIDE_AT);
    tl.to('#flash2', { opacity: 0, duration: 0.16, ease: 'power1.in' }, COLLIDE_AT + 0.04);
    tl.to(['#ru-block-u', '#ru-block-si'], { opacity: 0, duration: 0.12, ease: 'power2.in' }, COLLIDE_AT);
    tl.to('#ru-fused', { scale: 1, opacity: 1, duration: 0.35, ease: 'power3.out' }, COLLIDE_AT + 0.02);
    tl.to('#ru-glow', { scale: 1, opacity: 0.3, duration: 0.35, ease: 'power2.out' }, COLLIDE_AT + 0.02);

    const ruBurst = makeParticleBurst('ru-particles', {
      count: 14, palette: ['#00E5A0', '#FFFFFF'], radial: true,
      speedMin: 220, speedMax: 460, g: 50, sizeMin: 4, sizeMax: 8,
    });
    driveBurst(tl, ruBurst, COLLIDE_AT + 0.02, 0.55, 0.3);

    tl.to('#ru-strip', { opacity: 1, y: 0, duration: 0.35, ease: 'power3.out' }, COLLIDE_AT + 0.40);
    tl.to('#ru-bar', { scaleX: 1, duration: 0.35, ease: 'power2.out' }, COLLIDE_AT + 0.40);

    // ===================== SECTION 5 — HOLD (7.9 – 12.0, local 0-4.1) =====================
    gsap.set('#ho-hero', { opacity: 0, y: 14 });
    gsap.set('#ho-glow', { scale: 0.85, opacity: 0 });
    gsap.set('#ho-ghost', { opacity: 0 });
    gsap.set('#ho-strip', { opacity: 0, y: 12 });
    gsap.set('#ho-footer .chip-brand, #ho-footer .chip-ep', { opacity: 0, scale: 0.85 });
    gsap.set('#ho-sweep', { x: -260, opacity: 0 });

    tl.to('#ho-hero', { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' }, 7.95);
    tl.to('#ho-glow', { scale: 1, opacity: 0.26, duration: 0.4, ease: 'power2.out' }, 7.95);
    tl.to('#ho-ghost', { opacity: 1, duration: 0.3, ease: 'power2.out' }, 8.05);
    tl.to('#ho-strip', { opacity: 1, y: 0, duration: 0.35, ease: 'power3.out' }, 8.45);

    (function () {
      const items = gsap.utils.toArray('#ho-footer .chip-brand, #ho-footer .chip-ep');
      items.forEach((el, i) => {
        tl.fromTo(el, { scale: 0.85, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.36, ease: 'power3.out' }, 8.80 + i * 0.08);
      });
    })();

    // bounded glow breathe during the hold
    (function () {
      const glow = document.getElementById('ho-glow');
      const phase = { p: 0 };
      tl.to(phase, {
        p: Math.PI * 2 * 1.2,
        duration: 3.0,
        ease: 'none',
        onUpdate: () => {
          const s = Math.sin(phase.p);
          glow.style.opacity = String(0.26 + s * 0.04);
          glow.style.transform = `scale(${1 + s * 0.02})`;
        },
      }, 8.35);
    })();

    // single traveling sweep across the hold hero word
    tl.fromTo('#ho-sweep', { x: -260, opacity: 0 }, { x: 540, opacity: 0.5, duration: 1.0, ease: 'none' }, 9.7);
    tl.to('#ho-sweep', { opacity: 0, duration: 0.2, ease: 'power1.in' }, 10.7);

    window.__timelines['ep10-confusion-pilot'] = tl;
  </script>
</body>
