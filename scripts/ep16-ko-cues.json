[
  {
    "scene": "01-stakes",
    "text": "BOAT, RAIN, MEAT...",
    "start": 0.26,
    "end": 2.662
  },
  {
    "scene": "01-stakes",
    "text": "저도 이런 쉬운 단어 앞에서 순간 멈칫했던 적이 있어요.",
    "start": 2.755,
    "end": 9.2
  },
  {
    "scene": "01-stakes",
    "text": "모음이 두 개 나란히 붙어 있으면, 이걸 다 읽어야 하는 건지,",
    "start": 9.35,
    "end": 14.232
  },
  {
    "scene": "01-stakes",
    "text": "하나만 읽어야 하는 건지, 그런 기준이 있는지조차 몰랐거든요.",
    "start": 14.307,
    "end": 19.36
  },
  {
    "scene": "01-stakes",
    "text": "오늘 그 기준 하나만 알면, 이런 단어들 더 이상 멈추지 않고 바로 읽으실 수 있어요.",
    "start": 19.5,
    "end": 25.69
  },
  {
    "scene": "02-intro",
    "text": "안녕하세요, 「이해하면 쉬운영어」입니다.",
    "start": 26.292,
    "end": 30.32
  },
  {
    "scene": "02-intro",
    "text": "오늘은 모음 두 개가 나란히 붙어 있을 때,",
    "start": 30.471,
    "end": 34.013999999999996
  },
  {
    "scene": "02-intro",
    "text": "어느 쪽을 읽고 어느 쪽은 넘기는지, 그 기준 하나를 짚어드리겠습니다.",
    "start": 34.09,
    "end": 39.57
  },
  {
    "scene": "03-question",
    "text": "BOAT, 이 단어를 보면 모음이 O랑 A,",
    "start": 40.1,
    "end": 44.168
  },
  {
    "scene": "03-question",
    "text": "이렇게 두 개가 붙어 있습니다.",
    "start": 44.262,
    "end": 47.178
  },
  {
    "scene": "03-question",
    "text": "이 둘 중에 어떤 걸 소리를 내야 할까요?",
    "start": 47.256,
    "end": 50.839999999999996
  },
  {
    "scene": "03-question",
    "text": "O만 내야 할까요, 아님 A만 내야 할까요,",
    "start": 50.977,
    "end": 54.403999999999996
  },
  {
    "scene": "03-question",
    "text": "그것도 아니면 둘 다 내야 할까요?",
    "start": 54.544,
    "end": 56.690000000000005
  },
  {
    "scene": "04-headfake",
    "text": "결론부터 말씀드릴게요.",
    "start": 57.262,
    "end": 59.440000000000005
  },
  {
    "scene": "04-headfake",
    "text": "모음 두 개가 나란히 있으면, 둘 다 읽는 게 아니라 앞에 있는 모음 이름만 소리 내고,",
    "start": 59.59,
    "end": 66.683
  },
  {
    "scene": "04-headfake",
    "text": "뒤에 있는 모음은 그냥 무음으로 소리를 내지 않습니다.",
    "start": 66.766,
    "end": 71.76
  },
  {
    "scene": "04-headfake",
    "text": "BOAT는 O 이름 그대로 '오'라고만 읽고,",
    "start": 71.977,
    "end": 77.48
  },
  {
    "scene": "04-headfake",
    "text": "A는 소리를 안 내는 거예요.",
    "start": 77.56,
    "end": 80.12
  },
  {
    "scene": "04-headfake",
    "text": "저도 공부하기 전엔 모음 2개를 다 읽는 줄 알았습니다.",
    "start": 80.25200000000001,
    "end": 84.48
  },
  {
    "scene": "04-headfake",
    "text": "그러다 막상 실제 발음을 들어보면 제가 생각했던 거랑 다르니까,",
    "start": 84.617,
    "end": 89.35
  },
  {
    "scene": "04-headfake",
    "text": "'아...",
    "start": 89.421,
    "end": 89.93400000000001
  },
  {
    "scene": "04-headfake",
    "text": "왜 이렇지' 하고 그냥 넘기기만 했죠.",
    "start": 89.98400000000001,
    "end": 93.08000000000001
  },
  {
    "scene": "04-headfake",
    "text": "근데 공부를 하다 보니, 앞 글자 하나만 신경 쓰면 된다는 걸 알게 됐어요.",
    "start": 93.2,
    "end": 97.72999999999999
  },
  {
    "scene": "05-mechanism",
    "text": "원리는 간단해요.",
    "start": 98.36999999999999,
    "end": 100.25999999999999
  },
  {
    "scene": "05-mechanism",
    "text": "모음 두 개가 붙으면, 혀 입장에서는 두 개를 다 다른 소리로 내는 것보다 앞 모음은 자기 이름 그대로 시원하게 말하고,",
    "start": 100.425,
    "end": 110.33
  },
  {
    "scene": "05-mechanism",
    "text": "뒤에 있는 모음은 그냥 쉬는 게 훨씬 편하거든요.",
    "start": 110.399,
    "end": 114.16
  },
  {
    "scene": "05-mechanism",
    "text": "그래서 뒤 모음은 소리를 안 내는 거예요.",
    "start": 114.31299999999999,
    "end": 117.67999999999999
  },
  {
    "scene": "05-mechanism",
    "text": "COAT도 마찬가지예요.",
    "start": 117.812,
    "end": 120.32
  },
  {
    "scene": "05-mechanism",
    "text": "O랑 A가 붙어 있는데, O는 자기 이름 그대로 '오'라고 소리 내고,",
    "start": 120.503,
    "end": 126.496
  },
  {
    "scene": "05-mechanism",
    "text": "A는 조용히 쉬어요.",
    "start": 126.592,
    "end": 128.7
  },
  {
    "scene": "05-mechanism",
    "text": "그래서 '코트'라고 읽는 거죠 — 사실 여러분 이미 이 단어,",
    "start": 128.898,
    "end": 134.45499999999998
  },
  {
    "scene": "05-mechanism",
    "text": "알고 계셨잖아요.",
    "start": 134.526,
    "end": 135.36999999999998
  },
  {
    "scene": "06-pattern",
    "text": "우리가 이미 자주 쓰고 있는 단어로 이 규칙이 어떻게 통하는지 한 번 볼까요.",
    "start": 136.45700000000002,
    "end": 142.36
  },
  {
    "scene": "06-pattern",
    "text": "아까 봤던 RAIN, A 이름 그대로 '레인'이고요.",
    "start": 142.517,
    "end": 147.84
  },
  {
    "scene": "06-pattern",
    "text": "MEAT도 E 이름 그대로 '미트'예요.",
    "start": 147.922,
    "end": 151.54000000000002
  },
  {
    "scene": "06-pattern",
    "text": "PAINT도 마찬가지로 '페인트', TOAST도 '토스트'죠 — 그리고 다른 단어들도 한 번 더 보시죠.",
    "start": 151.67600000000002,
    "end": 160.34
  },
  {
    "scene": "06-pattern",
    "text": "TEAM도 E 이름 그대로 '팀'이고, PIE도 I 이름 그대로 '파이'예요.",
    "start": 160.428,
    "end": 168.08
  },
  {
    "scene": "06-pattern",
    "text": "이렇게 앞 모음 이름만 기억하면, 이 규칙을 사용해 새 단어를 봐도 망설이지 않고 바로 읽으실 수 있을 거예요.",
    "start": 168.216,
    "end": 175.37
  },
  {
    "scene": "07-exception",
    "text": "딱 하나만 알아두실 게 있습니다.",
    "start": 175.996,
    "end": 178.8
  },
  {
    "scene": "07-exception",
    "text": "오늘 배운 규칙, 대부분 잘 통하는데 EA만큼은 가끔 다르게 읽힐 때가 있어요.",
    "start": 178.982,
    "end": 186.84
  },
  {
    "scene": "07-exception",
    "text": "HEAD는 E랑 A가 붙어 있지만 '히드'가 아니라 '헤드'라고 읽고,",
    "start": 186.965,
    "end": 193.25400000000002
  },
  {
    "scene": "07-exception",
    "text": "BREAD도 '브레드', DEAD도 '데드'예요.",
    "start": 193.369,
    "end": 197.14000000000001
  },
  {
    "scene": "07-exception",
    "text": "이런 단어는 그때그때 소리 내면서 익숙해지는 수밖에 없어요 — 오늘 배운 규칙이 대부분의 단어를 뚫어주는 시작점이지,",
    "start": 197.29000000000002,
    "end": 206.90300000000002
  },
  {
    "scene": "07-exception",
    "text": "예외 없는 절대 규칙은 아니라는 것만 기억해두시면 됩니다.",
    "start": 206.966,
    "end": 210.49
  },
  {
    "scene": "08-quiz",
    "text": "그럼 직접 맞혀보세요.",
    "start": 211.219,
    "end": 213.541
  },
  {
    "scene": "08-quiz",
    "text": "첫 번째 단어, 어떻게 읽을까요?",
    "start": 213.72,
    "end": 216.93599999999998
  },
  {
    "scene": "08-quiz",
    "text": "잠깐 생각해 보세요.",
    "start": 217.11499999999998,
    "end": 219.07999999999998
  },
  {
    "scene": "08-quiz",
    "text": "앞 모음 이름 그대로, '시트'입니다.",
    "start": 219.26399999999998,
    "end": 222.939
  },
  {
    "scene": "08-quiz",
    "text": "두 번째 단어는요?",
    "start": 223.12199999999999,
    "end": 224.951
  },
  {
    "scene": "08-quiz",
    "text": "이것도 앞 모음 이름 그대로, '골'이죠.",
    "start": 225.125,
    "end": 228.59199999999998
  },
  {
    "scene": "08-quiz",
    "text": "마지막 문제, 이번엔 좀 다를 수 있어요.",
    "start": 228.75699999999998,
    "end": 232.71999999999997
  },
  {
    "scene": "08-quiz",
    "text": "세 번째 단어는요?",
    "start": 232.938,
    "end": 235.12199999999999
  },
  {
    "scene": "08-quiz",
    "text": "정답은, '스웻'입니다.",
    "start": 235.33999999999997,
    "end": 237.95999999999998
  },
  {
    "scene": "08-quiz",
    "text": "EA인데, 아까 배운 예외였죠.",
    "start": 238.135,
    "end": 240.41
  },
  {
    "scene": "09-listening",
    "text": "이제 진짜 문장 속에서 확인해 볼까요? 첫 번째.",
    "start": 240.56,
    "end": 245.12
  },
  {
    "scene": "09-listening",
    "text": "I need a new coat for winter.",
    "start": 245.42000000000002,
    "end": 247.74
  },
  {
    "scene": "09-listening",
    "text": "두 번째.",
    "start": 248.24,
    "end": 249.52
  },
  {
    "scene": "09-listening",
    "text": "It might rain tomorrow.",
    "start": 249.77,
    "end": 252.17000000000002
  },
  {
    "scene": "09-listening",
    "text": "세 번째.",
    "start": 252.67000000000002,
    "end": 254.15
  },
  {
    "scene": "09-listening",
    "text": "We had a team meeting today.",
    "start": 254.4,
    "end": 256.88
  },
  {
    "scene": "09-listening",
    "text": "네 번째.",
    "start": 257.38,
    "end": 258.7
  },
  {
    "scene": "09-listening",
    "text": "My head hurts a little.",
    "start": 258.95,
    "end": 260.90999999999997
  },
  {
    "scene": "09-listening",
    "text": "어떠세요? 이제 낯선 단어가 나와도, 앞 모음 이름만 떠올리면 자신 있게 읽으실 수 있을 거예요.",
    "start": 261.51,
    "end": 268.95
  },
  {
    "scene": "10-practice",
    "text": "자, 이제 직접 소리 내서 읽어보세요.",
    "start": 269.462,
    "end": 273.07
  },
  {
    "scene": "10-practice",
    "text": "따라 읽다 보면 저절로 자신감이 붙으실 거예요.",
    "start": 273.234,
    "end": 277.51
  },
  {
    "scene": "10-practice",
    "text": "BOAT, 천천히.",
    "start": 277.731,
    "end": 280.409
  },
  {
    "scene": "10-practice",
    "text": "보, 트 — 이어서, 보트!",
    "start": 280.459,
    "end": 285.179
  },
  {
    "scene": "10-practice",
    "text": "다시 한 번, 좀 더 빠르게.",
    "start": 285.477,
    "end": 288.89
  },
  {
    "scene": "10-practice",
    "text": "보트, 보트.",
    "start": 289.118,
    "end": 290.71
  },
  {
    "scene": "10-practice",
    "text": "이번엔 MEAT예요.",
    "start": 290.988,
    "end": 293.49
  },
  {
    "scene": "10-practice",
    "text": "미, 트 — 이어서, 미트!",
    "start": 293.824,
    "end": 297.092
  },
  {
    "scene": "10-practice",
    "text": "다시 한 번, 좀 더 빠르게.",
    "start": 297.159,
    "end": 301.995
  },
  {
    "scene": "10-practice",
    "text": "미트, 미트.",
    "start": 302.162,
    "end": 303.83
  },
  {
    "scene": "10-practice",
    "text": "마지막으로 예외였던 단어도 같이 볼까요.",
    "start": 303.988,
    "end": 307.46999999999997
  },
  {
    "scene": "10-practice",
    "text": "HEAD예요.",
    "start": 307.628,
    "end": 309.05
  },
  {
    "scene": "10-practice",
    "text": "헤, 드 — 이어서, 헤드!",
    "start": 309.432,
    "end": 313.53999999999996
  },
  {
    "scene": "10-practice",
    "text": "다시 한 번, 좀 더 빠르게.",
    "start": 313.831,
    "end": 316.743
  },
  {
    "scene": "10-practice",
    "text": "헤드, 헤드.",
    "start": 316.844,
    "end": 317.48
  },
  {
    "scene": "11-payoff",
    "text": "이제 정말 이 규칙 하나로, 처음 보는 단어도 바로 읽으실 수 있어요.",
    "start": 318.117,
    "end": 323.69
  },
  {
    "scene": "11-payoff",
    "text": "예를 들어 이 단어, 오늘 처음 보셨죠?",
    "start": 323.83299999999997,
    "end": 326.96999999999997
  },
  {
    "scene": "11-payoff",
    "text": "그래도 한번 볼까요.",
    "start": 327.11199999999997,
    "end": 328.827
  },
  {
    "scene": "11-payoff",
    "text": "앞 모음 이름 그대로, 정답은 '그레인'입니다.",
    "start": 328.986,
    "end": 333.25
  },
  {
    "scene": "11-payoff",
    "text": "하나 더 볼까요.",
    "start": 333.42199999999997,
    "end": 334.964
  },
  {
    "scene": "11-payoff",
    "text": "이것도 앞 모음 이름 그대로, '포움'이에요.",
    "start": 335.13,
    "end": 338.81
  },
  {
    "scene": "11-payoff",
    "text": "하나만 더요.",
    "start": 338.99,
    "end": 340.25
  },
  {
    "scene": "11-payoff",
    "text": "이번에도 똑같이, '리치'죠.",
    "start": 340.439,
    "end": 343.23199999999997
  },
  {
    "scene": "11-payoff",
    "text": "어떠세요, 낯선 단어들인데도 계속 바로 읽히시죠?",
    "start": 343.303,
    "end": 347.65
  },
  {
    "scene": "11-payoff",
    "text": "여태 이걸 다 읽어야 하는지, 하나만 읽어야 하는지,",
    "start": 347.804,
    "end": 352.039
  },
  {
    "scene": "11-payoff",
    "text": "그런 기준이 있는지조차 몰랐던 게, 사실 이 기준 하나만 알면 끝나는 일이었던 거예요.",
    "start": 352.109,
    "end": 357.6
  },
  {
    "scene": "12-summary",
    "text": "오늘은 모음 두 개가 나란히 붙으면, 앞 모음은 이름 그대로 소리 내고 뒤 모음은 무음이 된다는 원리,",
    "start": 358.207,
    "end": 367.48199999999997
  },
  {
    "scene": "12-summary",
    "text": "그리고 EA는 가끔 다르게 읽히는 예외까지 함께 봤습니다.",
    "start": 367.574,
    "end": 373.47
  },
  {
    "scene": "12-summary",
    "text": "이제 모음 두 개가 붙은 낯선 단어를 봐도,",
    "start": 373.624,
    "end": 377.253
  },
  {
    "scene": "12-summary",
    "text": "예전처럼 멈칫하지 않고 망설임 없이 바로 읽으실 수 있을 거예요.",
    "start": 377.331,
    "end": 382.89
  },
  {
    "scene": "12-summary",
    "text": "다음에도 여러분이 자주 막막해하시는 부분,",
    "start": 383.046,
    "end": 386.709
  },
  {
    "scene": "12-summary",
    "text": "또 풀어드릴게요.",
    "start": 386.787,
    "end": 388.19
  },
  {
    "scene": "12-summary",
    "text": "저와 같이 하나씩 차근차근 익혀 나가시면,",
    "start": 388.346,
    "end": 391.85
  },
  {
    "scene": "12-summary",
    "text": "어느새 훨씬 자신 있게 읽고 계실 거예요.",
    "start": 391.928,
    "end": 395.51
  }
]