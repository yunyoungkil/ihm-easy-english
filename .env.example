# ==========================================
# 이해하면 쉬운영어 (.env 예시 템플릿)
# ==========================================

# 1. YouTube Data API v3 키
YOUTUBE_API_KEY=

# 2. Google Gemini API 키
GEMINI_API_KEY=

# 3. YouTube OAuth 2.0 클라이언트 인증 정보
# 리디렉션 URI: http://localhost:3001/oauth2callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# (선택) 포트 설정
YOUTUBE_ANALYTICS_PORT=3001

# 4. 쿠팡 파트너스 API (파트너스 화면: 추가 기능 → 파트너스 API). 새벽 블로그 글쓰기를 도는 집 PC에만 넣는다.
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
