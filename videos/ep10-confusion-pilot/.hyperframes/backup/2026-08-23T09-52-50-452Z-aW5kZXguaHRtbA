    #ru-glow{top:110px}
    #ho-glow{top:200px}
    .glitch-stack{position:relative;z-index:2;display:grid}
    .glitch-base,.glitch-copy{grid-area:1/1;font-family:Bebas,sans-serif;font-size:148px;line-height:1;letter-spacing:.005em;white-space:nowrap}
    .glitch-base{color:var(--ink);z-index:2}
    .glitch-copy{z-index:1;opacity:0;will-change:transform;mix-blend-mode:screen}
