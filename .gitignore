node_modules
dist
.DS_Store
.env
.env*
.env.*
client_secret_*.json
.youtube-oauth-token.json
.youtube-video-map.json

# Ignore the output video from Git but not videos you import into src/.
out

# Whisper.cpp binary + models + scratch audio used by scripts/generate-highlights.mjs
.whisper
.whisper-scratch
.tts-usage.json

# Design reference footage (~498MB). Studied to derive the `reference` motion
# style; nothing renders from it, so it stays out of history. Keep locally.
public/reference

# Real screenshots/photos used only as mood-board reference (never rendered
# directly — frame.md "Approved Entities" bans real logos/photos/faces in any
# output). EP14: a real Netflix browse-grid screenshot, kept as the visual
# reference behind Frame 1's invented placeholder grid; must stay out of
# history (real actors' faces + copyrighted poster art + Netflix branding).
videos/*/compositions/images/
videos/**/디자인*/

# Rendered video files (tens of MB each, grows every episode) — keep locally,
# never commit. Text/metadata/thumbnails in the same folders stay tracked.
output/upload-packages/**/*.mp4
videos/**/renders/*.mp4
renders/
*.log

# Personal tool config — this folder doubles as an Obsidian vault and VS Code
# workspace; app state/settings aren't project content.
.obsidian
.vscode

# Personal BGM library (~181MB, 35 royalty-free tracks) — source material each
# episode loops/trims a short slice from into assets/bgm/track.loop.mp3 inside
# its own videos/<project>/ folder (which IS tracked). The library itself is
# reusable across episodes but not project content, so it stays local only.
public/audio/BGM 35

# Scratch/log working files, regenerable.
tmp
scratch
data/youtube/studio-browser-profile
data/youtube/*.png

# HyperFrames tool-generated caches inside each project folder — crash-recovery
# state, timeline preview thumbnails, waveform analysis cache, and the
# media-use skill's local resolve index. All regenerate automatically and
# were never meant to be committed (CLAUDE.md already documented .hyperframes
# as "never committed" but it wasn't actually ignored yet — EP15 alone added
# 200+ .thumbnails/ preview JPGs to git status, 2026-09-11).
videos/*/.hyperframes/
videos/*/.thumbnails/
videos/*/.waveform-cache/
videos/*/.whisper-scratch/
videos/*/.media/

# A/B 시뮬레이터 AI 생성 썸네일 — output/temp-thumbnails/에 파일로 저장됨(localStorage
# base64 용량 문제 회피용, knowledge/now.md 2026-09-01 기록 참고). 재생성 가능하므로 미추적.
output/temp-thumbnails

# YouTube Studio CSV 원본 폴더 — scripts/youtube-analytics-server.mjs의 폴더 스캔이 즉시
# data/youtube/video-reach-manual.json으로 파싱해 저장하므로, 원본 CSV는 파싱 후 필요 없는
# 중간 산출물이다. 정리 안 하면 겹치는 날짜 구간이 매번 새 폴더로 계속 쌓여 레포가 무한정
# 커진다(2026-09-03 확인, 98개 파일 누적). 스캔 완료된 폴더는 youtube-studio-archive로 자동
# 이동되는데 그것도 같은 이유로 미추적.
imports/youtube-studio
imports/youtube-studio-archive

# Local cache, sqlite db and snapshots
*.db
__pycache__/
scripts/__pycache__/
data/youtube/snapshots/
scripts/_ep20_raw_*
scripts/_lora_train_log*
videos/*/.check-output.txt


# 매일 루프(scripts/daily-loop.mjs)가 켠 대시보드의 로그
data/youtube/daily-loop-server.log
# 검색 피드 하루 캐시(scripts/thumb-feed.mjs)와 PC별 매일 루프 실행 결과 — PC마다 다르고 다시 만들어진다
data/youtube/thumb-feed-cache.json
data/youtube/daily-loop.json

# 경쟁 영상 화면 캡처(합친 아웃라이어 리포트, 2026-11-12) — 저작권·용량 때문에 이 PC에만 둔다
data/youtube/outlier-frames/
